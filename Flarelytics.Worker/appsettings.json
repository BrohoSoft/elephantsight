{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Secrets": {
    "KeysDirectory": "/run/secrets/flarelytics-keys",
    "ActiveKeyVersion": "v1",
    "StorageDirectory": "/var/lib/flarelytics/secrets"
  },
  "Reports": {
    "StorageDirectory": "/var/lib/flarelytics/reports"
  }
}
