# Copia in .env e compila. .env non va nel repository.

# Il dominio pubblico, già puntato su questa macchina.
DOMINIO=app.flarelytics.example

# Password dell'amministratore di PostgreSQL (usata solo per inizializzare)
# e del ruolo con cui si collega l'applicazione.
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=

# Firma degli access token: almeno 32 caratteri casuali.
#   openssl rand -base64 48
JWT_KEY=

# La chiave master attiva: il nome del file in keys/ senza .key.
MASTER_KEY_VERSION=v1

# SMTP per le email di conferma e di recupero password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
